# =====================================================================
# Sköll Companion Service — Example Environment Template
# Copy this file to .env and populate with your credentials.
# =====================================================================

# Server Settings
SKOLL_PORT=8081
SKOLL_PUBLIC_URL=http://localhost:8081
SKOLL_DB_PATH=skoll.db
SKOLL_HTTP_TIMEOUT_SECONDS=15

# Discord Bot & OAuth2 Integration
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=http://localhost:8081/auth/callback
# Session Encryption (optional; derived from client secret if omitted)
# SKOLL_SESSION_SECRET=

# Fenrir Daemon Orchestrator Bridge
FENRIR_API_URL=http://localhost:8080
FENRIR_API_KEY=
